[Unit]
Description=Henan Recruitment Monitor daily health receipt
After=network-online.target

[Service]
Type=oneshot
User=recruit-monitor
Group=recruit-monitor
WorkingDirectory=/opt/henan-recruit-monitor
EnvironmentFile=/etc/henan-recruit-monitor.env
ExecStart=/usr/bin/python3 -m app.cli --config-dir config --db data/recruit_monitor.db --log-dir logs heartbeat
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/henan-recruit-monitor/data /opt/henan-recruit-monitor/logs
