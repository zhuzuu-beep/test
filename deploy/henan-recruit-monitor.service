[Unit]
Description=Henan Recruitment Monitor one-shot run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=recruit-monitor
Group=recruit-monitor
WorkingDirectory=/opt/henan-recruit-monitor
EnvironmentFile=/etc/henan-recruit-monitor.env
ExecStart=/usr/bin/python3 -m app.cli --config-dir config --db data/recruit_monitor.db --log-dir logs run --feed hnrsks_home --aggregation-window 0
ExecStart=/usr/bin/python3 -m app.cli --config-dir config --db data/recruit_monitor.db --log-dir logs deliver
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/henan-recruit-monitor/data /opt/henan-recruit-monitor/logs /opt/henan-recruit-monitor/backups

[Install]
WantedBy=multi-user.target
